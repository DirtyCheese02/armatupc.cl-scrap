[Unit]
Description=ArmaTuPC local daily scrape and fenced publication
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/armatupc/scraper/current
Environment=PUBLISH_ENABLED=1
ExecStartPre=-/usr/bin/docker stop armatupc-specdb-worker armatupc-llama
ExecStart=/srv/armatupc/scraper/current/ops/server/run-local-daily.sh
ExecStopPost=-/usr/bin/docker start armatupc-llama armatupc-specdb-worker
TimeoutStartSec=8h
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
